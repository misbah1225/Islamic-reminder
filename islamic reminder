            tk.Label(
                inner, text=fix_arabic_line(line),
                font=(ARABIC_FONT_NAME, ARABIC_FONT_SIZE),
                fg="#f5d76e", bg="#0f3d2e", justify="center",
            ).pack(pady=2)
        else:
            tk.Label(
                inner, text=line,
                font=(FONT_NAME, 12), fg="white", bg="#0f3d2e",
                wraplength=500, justify="center",
            ).pack()

    col = 0

    def add_button(text, command, bg):
        nonlocal col
        tk.Button(btn_frame, text=text, command=command,
                  font=(FONT_NAME, 10), bg=bg, fg="white").grid(row=0, column=col, padx=4)
        col += 1

    if PLAYLIST_1.startswith("http"):
        add_button("▶ প্লেলিস্ট ১", lambda: open_url(popup, PLAYLIST_1), "#2e8b57")
    if PLAYLIST_2.startswith("http"):
        add_button("▶ প্লেলিস্ট ২", lambda: open_url(popup, PLAYLIST_2), "#2e8b57")
    add_button("🎧 গজল", lambda: play_random_gojol(popup), "#8e6e1f")
    add_button("📖 কিরাত", lambda: play_random_surah(popup), "#1f6f8e")
    add_button("ঠিক আছে, ফিরছি", popup.destroy, "#555")

    popup.after(AUTO_CLOSE_SECONDS * 1000,
                lambda: popup.winfo_exists() and popup.destroy())


def schedule_next(root):
    minutes = random.randint(MIN_MINUTES, MAX_MINUTES)
    print(f"পরের রিমাইন্ডার {minutes} মিনিট পর")
    root.after(minutes * 60 * 1000, lambda: (show_popup(root), schedule_next(root)))


def main():
    root = tk.Tk()
    root.withdraw()
    show_popup(root)  # টেস্টের জন্য চালু হওয়ার সাথে সাথে একবার দেখাবে
    schedule_next(root)
    root.mainloop()


if __name__ == "__main__":
    main()
