def youtube_search(query):
    url = "https://www.youtube.com/results?search_query=" + quote_plus(query)
    webbrowser.open(url)


def find_video_url(query):
    """সার্চ করে সময়ের মধ্যে পড়ে এমন প্রথম ভিডিওর লিংক ফেরত দেয়"""
    opts = {"quiet": True, "extract_flat": True, "skip_download": True}
    try:
        with YoutubeDL(opts) as ydl:
            info = ydl.extract_info(f"ytsearch10:{query}", download=False)
        entries = [e for e in info.get("entries", []) if e and e.get("id")]
        for e in entries:
            d = e.get("duration")
            if d and MIN_SEC <= d <= MAX_SEC:
                return f"https://www.youtube.com/watch?v={e['id']}&autoplay=1"
        if entries:  # সময় মেলে এমন না পেলে প্রথমটাই
            return f"https://www.youtube.com/watch?v={entries[0]['id']}&autoplay=1"
    except Exception as ex:
        print("সার্চে সমস্যা:", ex)
    return None


def play_in_background(query):
    """পপআপ আটকে না রেখে ব্যাকগ্রাউন্ডে ভিডিও খুঁজে চালায়"""
    def worker():
        url = find_video_url(query)
        if not url:  # ব্যর্থ হলে অন্তত সার্চ পেজ খুলবে
            url = "https://www.youtube.com/results?search_query=" + quote_plus(query)
        webbrowser.open(url)
    threading.Thread(target=worker, daemon=True).start()


