# ================== একই জিনিস পরপর না আসার ব্যবস্থা ==================
class Bag:
    def __init__(self, items):
        self.items = items
        self.bag = []
        self.last = None

    def next(self):
        if not self.bag:
            self.bag = self.items.copy()
            random.shuffle(self.bag)
            # নতুন রাউন্ডের প্রথমটা আগের রাউন্ডের শেষটার মতো যেন না হয়
            if len(self.bag) > 1 and self.bag[-1] == self.last:
                self.bag[0], self.bag[-1] = self.bag[-1], self.bag[0]
        self.last = self.bag.pop()
        return self.last


