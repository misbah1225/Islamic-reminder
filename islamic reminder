ARABIC_FONT_SIZE = 16

ARABIC_RE = re.compile(r'[\u0600-\u06FF\u0750-\u077F\uFB50-\uFDFF\uFE70-\uFEFF]')


def _move_marks_after_base(text):
    """উল্টানোর পর হরকত অক্ষরের আগে চলে যায়; সেগুলো আবার অক্ষরের পরে বসায়"""
    out, marks = [], []
    for ch in text:
        if unicodedata.category(ch) == "Mn":
            marks.append(ch)
        else:
            out.append(ch)
            out.extend(reversed(marks))
            marks = []
    out.extend(reversed(marks))
    return "".join(out)


def fix_arabic_line(line):
    if not (FIX_ARABIC and LIBS_OK):
        return line
    if not ARABIC_RE.search(line):
        return line
    reshaped = _RESHAPER.reshape(line)
    return _move_marks_after_base(get_display(reshaped))


